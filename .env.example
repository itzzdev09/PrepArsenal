# PrepArsenal — Environment Variables
# Copy this file to .env.local and fill in your API keys

# =============================================================================
# LLM providers — the gateway (lib/llm.ts) tries them top-to-bottom and fails
# over on any error. A key that hits its quota (429/402/403) is put on a short
# cooldown and the next key/provider is used automatically.
#
# You only need ONE provider to work, but the more you add, the more free
# capacity you stack (each provider has an independent free bucket).
#
# KEY POOLING: every provider accepts a comma-separated list. Create multiple
# free accounts and paste each key here to multiply throughput, e.g.
#   GEMINI_API_KEYS=key_from_account_1,key_from_account_2,key_from_account_3
# The single-key form (GEMINI_API_KEY=...) still works as a fallback.
# =============================================================================

# Cerebras — ~1M tokens/day free, extremely fast, Llama 3.3 70B. https://cloud.cerebras.ai
CEREBRAS_API_KEYS=
# CEREBRAS_MODEL=llama-3.3-70b

# Groq — very high requests/day on the 8B instant model, fast. https://console.groq.com/keys
GROQ_API_KEYS=
# GROQ_MODEL=llama-3.1-8b-instant

# Mistral — ~1B tokens/month free (largest single free bucket). https://console.mistral.ai
MISTRAL_API_KEYS=
# MISTRAL_MODEL=mistral-small-latest

# Google Gemini — ~1,500 req/day PER key. Add keys from multiple Google projects. https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# GEMINI_MODEL=gemini-3.6-flash

# OpenRouter — one key, many ":free" models. https://openrouter.ai/keys
OPENROUTER_API_KEYS=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_SITE_URL=https://preparsenal.app

# GitHub Models — free with a GitHub PAT (models:read scope). https://github.com/marketplace/models
GITHUB_MODELS_API_KEYS=
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini
# GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# Self-hosted Ollama — unlimited, no rate limit. Set the base URL to enable it as
# the last network provider before the offline RAG-only fallback.
#   ollama pull qwen2.5:3b  &&  ollama serve
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:3b

# Optional: override failover order (comma-separated provider names).
# LLM_PROVIDER_ORDER=groq,cerebras,mistral,gemini,openrouter,github-models,ollama

# === Supabase (Write-Heavy User State: Auth, Profiles, Reviews, Notes) ===
NEXT_PUBLIC_SUPABASE_URL=abcd
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=abcd

# === Turso Edge Database (Read-Heavy Scale: 9GB Free Tier for Millions of PYQs) ===
# Optional: Get yours at https://turso.tech (defaults to embedded local SQLite if omitted)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
