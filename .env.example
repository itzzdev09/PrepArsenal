# PrepArsenal — Environment Variables
# Copy this file to .env.local and fill in your API keys

# === LLM API Keys (Both are free to obtain) ===

# Primary: Google Gemini API (1,500 req/day free)
# Get yours at: https://aistudio.google.com/apikey
# Server-only (no NEXT_PUBLIC_ prefix) — used only from app/api/tutor/chat/route.ts
GEMINI_API_KEY=abcd

# Fallback: Groq API (fast Llama inference, free tier)
# Get yours at: https://console.groq.com/keys
# Server-only (no NEXT_PUBLIC_ prefix) — used only from app/api/tutor/chat/route.ts
GROQ_API_KEY=abcd

# === Supabase (Write-Heavy User State: Auth, Profiles, Reviews, Notes) ===
NEXT_PUBLIC_SUPABASE_URL=abcd
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=abcd

# === Turso Edge Database (Read-Heavy Scale: 9GB Free Tier for Millions of PYQs) ===
# Optional: Get yours at https://turso.tech (defaults to embedded local SQLite if omitted)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token