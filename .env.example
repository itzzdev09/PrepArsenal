# PrepArsenal — Environment Variables
# Copy this file to .env.local and fill in your API keys

# === LLM API Keys (Both are free to obtain) ===

# Primary: Google Gemini API (1,500 req/day free)
# Get yours at: https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=

# Fallback: Groq API (fast Llama inference, free tier)
# Get yours at: https://console.groq.com/keys
NEXT_PUBLIC_GROQ_API_KEY=

# === Supabase (Optional — app works with localStorage without this) ===
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
